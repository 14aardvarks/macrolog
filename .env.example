# Copy this file to .env and fill it in. docker compose reads .env (never commit it).
#
# Settings marked [live] can also be changed by an administrator in the app's Admin page.
# A value saved there wins over this file until it is cleared again ("use environment").
# The others are environment only and need a restart to change.

# ---- Required ----

# Signs the session cookie. Optional: if empty, a key is generated on first start and saved in the data folder.
# If you set it, it must be at least 32 characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, and secrets saved in the Admin page (and personal Claude keys)
# can no longer be decrypted and must be entered again. Keep it with your backups.
SECRET_KEY=

# ---- Accounts ----

# [live] Password sign-in. 1 enables it, 0 disables it (use only with OIDC_* set).
LOCAL_LOGIN=1

# Optional. Normally leave these empty: on a fresh install the app shows a one-time setup screen
# where you create the first administrator in the browser. As an alternative, this creates
# ADMIN_USER with ADMIN_PASSWORD as an administrator at startup, only while the users table is empty.
# ADMIN_USER is also made an administrator again at every start (only if that account has a password). The password must be at least
# 8 characters. Remove both lines after the first start.
ADMIN_USER=
ADMIN_PASSWORD=

# ---- Single sign-on (authentik, OpenID Connect) ----

# [live] All OIDC_* settings. Easiest is to leave them empty here and fill them in the app under
# Admin > Sign-in, which shows the redirect URI and has a Test connection button (see the README).
# The issuer must match exactly, including the trailing slash, for example
# https://auth.example.com/application/o/macrolog/
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Set this for a confidential client (the authentik setup in the README uses one).
OIDC_CLIENT_SECRET=
# Label on the sign-in button. Defaults to "authentik".
OIDC_NAME=authentik
# 0 (default) refuses SSO logins that do not match an existing account. Users link their account
# with Connect SSO in Settings, or an existing account is matched by email when the ID token has
# email_verified true. 1 lets any SSO login create an account.
OIDC_ALLOW_SIGNUP=0
# [live] Optional authentik group names. Members of the admin group become Macrolog admins at each SSO
# sign-in (empty = manage admins by hand). With a user group set, SSO sign-in needs that group or the
# admin group. The claim that lists groups defaults to "groups".
OIDC_ADMIN_GROUP=
OIDC_USER_GROUP=
OIDC_GROUPS_CLAIM=groups

# ---- Public address and HTTPS ----

# External base URL of the app, without a trailing slash. Used for the SSO redirect URI
# (PUBLIC_URL/auth/oidc/callback) and as the expected origin for state-changing requests.
# Required for single sign-on. Environment only, because it decides which origin is trusted.
# Example: https://macrolog.example.com
PUBLIC_URL=

# Set to 1 when the app sits behind a reverse proxy that you control. The login rate limit
# then reads the client address from the last X-Forwarded-For entry. Do not set it when
# port 8000 is reachable without the proxy, because clients could forge that header.
TRUST_PROXY=0

# Set to 1 when the site is served over HTTPS. Marks the session cookie Secure.
COOKIE_SECURE=0

# ---- Claude label reader (optional) ----

# [live] Household Claude key for the "Ask Claude" photo reader. Leave empty to keep it off.
# Each user can also add a personal key in Settings, which is used before this one.
ANTHROPIC_API_KEY=
# [live] Model used for label reading. Haiku is recommended: only model ids containing "haiku" are forced
# to call the label tool. Other models may answer without it, which shows as an error.
AI_MODEL=claude-haiku-5-5
# [live] Maximum requests per calendar month with the household key, counted across all users.
# Requests made with a personal key count only against that user's own limit.
AI_MONTHLY_REQUEST_CAP=100
# [live] Price of the model in USD per million tokens, used only to show estimated and monthly cost.
# Both must be set, otherwise the app says "Cost not available". Check Anthropic's pricing page for your model.
# Third party sources reported 0.10 and 0.50 for claude-haiku-5-5 (prompts up to 100K tokens), not verified against Anthropic.
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=

# ---- Food database lookups (optional) ----

# [live] USDA FoodData Central API key (empty means DEMO_KEY). Use a real free key from https://api.data.gov/signup/ because
# DEMO_KEY is heavily rate limited. Typing in the search box only searches your own foods
# (remote=0). Enter or the Search button also queries USDA (remote=1), and that uses this key.
FDC_API_KEY=DEMO_KEY

# ---- Advanced ----

# Path of the SQLite database inside the container. The image sets /data/macrolog.db,
# which is on the macrolog-data volume. Change it only if you also change the volume.
# DB_PATH=/data/macrolog.db
